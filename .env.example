# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
# True only on your own computer.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# Full origins (with https://) allowed to submit forms/CMS requests.
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Public URL of the site (used for canonical links, sitemap, social sharing).
SITE_URL=https://your-domain.com

# --- Database -----------------------------------------------------------
# Leave unset locally to use SQLite (db.sqlite3). In production use PostgreSQL:
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Media (uploaded photos, CV, certificates) ----------------------------
# Local disk (default). Point at a persistent disk in production.
MEDIA_ROOT=media
# Or S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2...). Set USE_S3_MEDIA=True and:
USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# --- Optional -------------------------------------------------------------
# Only needed if the frontend is hosted on a different domain than Django.
CORS_ALLOWED_ORIGINS=
# Set to False only if HTTPS is already enforced by your host's proxy.
SECURE_SSL_REDIRECT=True
THROTTLE_LOGIN=5/min
